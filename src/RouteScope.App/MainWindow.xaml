<Window x:Class="RouteScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:RouteScope.App.Views"
        Title="RouteScope"
        Icon="Assets/app.ico"
        Width="1240" Height="890" MinWidth="1040" MinHeight="740"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ title bar ============================ -->
        <Grid Grid.Row="0" x:Name="TitleBar" Background="{StaticResource B.Bg.Sunken}"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource B.AccentGradient}">
                    <Canvas Width="24" Height="24">
                        <Path Data="M 6,17 C 11,17 11,7 18,7" Stroke="#FFFFFFFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="4.4" Canvas.Top="15.4" Width="3.4" Height="3.4" Fill="#FFFFFFFF" />
                        <Ellipse Canvas.Left="16.2" Canvas.Top="5.2" Width="3.4" Height="3.4" Fill="#FFFFFFFF" />
                    </Canvas>
                </Border>
                <TextBlock Text="RouteScope" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource F.Display}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Text.Primary}" />
                <Border Style="{StaticResource Chip}" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                        Background="{StaticResource B.Bg.Elevated}">
                    <TextBlock Text="BETA" FontSize="9.5" FontWeight="Bold"
                               Foreground="{StaticResource B.Text.Tertiary}" />
                </Border>
            </StackPanel>

            <!-- center: live status pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="StatusPill" CornerRadius="999" Padding="11,4"
                        BorderThickness="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource B.Bg.Elevated}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource B.Success.Soft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource B.Danger.Soft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Text.Tertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusTitle}" Margin="7,0,0,0" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource B.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- window buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="MinButton" Width="46" Click="Minimize_Click" Style="{StaticResource Btn.Ghost}"
                        Padding="0" ToolTip="Minimise">
                    <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
                <Button x:Name="MaxButton" Width="46" Click="Maximize_Click" Style="{StaticResource Btn.Ghost}"
                        Padding="0" ToolTip="Maximise">
                    <TextBlock Text="&#xE922;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Width="46" Click="Close_Click" Style="{StaticResource Btn.Ghost}"
                        Padding="0" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================== body ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Background="{StaticResource B.Bg.Sunken}"
                    BorderBrush="{StaticResource B.Border.Subtle}" BorderThickness="0,1,1,0">
                <DockPanel Margin="12,14,12,12">

                    <!-- bottom: engine card -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Style="{StaticResource Card.Tight}" Padding="12" CornerRadius="12"
                                Background="{StaticResource B.Bg.Surface}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource B.Warning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EngineReady}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource B.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Engine" Margin="7,0,0,0" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Text.Secondary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding EngineStatusText}" Margin="0,5,0,0" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource B.Text.Tertiary}" />
                                <Button Content="Install / update" Margin="0,9,0,0" Height="28"
                                        FontSize="11.5" Padding="0"
                                        Style="{StaticResource Btn.Secondary}"
                                        Command="{Binding DownloadEngineCommand}"
                                        Visibility="{Binding EngineMissing, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="v1.0.0" Margin="4,10,0,0" FontSize="10.5"
                                   Foreground="{StaticResource B.Text.Tertiary}" />
                    </StackPanel>

                    <!-- nav -->
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource Text.Caption}" Margin="12,0,0,8" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Overview"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Home}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8B7;" Content="What to route"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Targets}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Where to route"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Servers}" />

                        <TextBlock Text="MONITOR" Style="{StaticResource Text.Caption}" Margin="12,18,0,8" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Live connections"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Live}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7C3;" Content="Activity log"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Logs}" />

                        <TextBlock Text="SYSTEM" Style="{StaticResource Text.Caption}" Margin="12,18,0,8" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xEB51;" Content="Support RouteScope"
                                     GroupName="Nav" IsChecked="{Binding CurrentPage, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Support}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- page header -->
                <Grid Grid.Row="0" Margin="34,26,34,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Text.Secondary}"
                                   Margin="0,5,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    </StackPanel>
                </Grid>

                <!-- pages -->
                <Grid Grid.Row="1" Margin="34,20,34,0">
                    <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}" />
                    <views:TargetsView Visibility="{Binding IsTargets, Converter={StaticResource BoolToVis}}" />
                    <views:ServersView Visibility="{Binding IsServers, Converter={StaticResource BoolToVis}}" />
                    <views:LiveView Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}" />
                    <views:LogsView Visibility="{Binding IsLogs, Converter={StaticResource BoolToVis}}" />
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}" />
                    <views:SupportView Visibility="{Binding IsSupport, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================= first-run wizard ========================= -->
        <Border Grid.RowSpan="2" Background="#E6000000"
                Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="620" Style="{StaticResource Card}" Padding="34,30" CornerRadius="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.6" Color="#FF000000" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- step dots -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="26" Height="4" CornerRadius="2" Margin="3,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource B.Bg.Active}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="0">
                                            <Setter Property="Background" Value="{StaticResource B.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Width="26" Height="4" CornerRadius="2" Margin="3,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource B.Bg.Active}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource B.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Width="26" Height="4" CornerRadius="2" Margin="3,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource B.Bg.Active}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource B.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>

                    <!-- step 1 -->
                    <StackPanel Visibility="{Binding OnboardingIsIntro, Converter={StaticResource BoolToVis}}">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource B.AccentGradient}"
                                HorizontalAlignment="Center">
                            <Canvas Width="56" Height="56">
                                <Path Data="M 15,39 C 27,39 27,17 42,17" Stroke="#FFFFFFFF" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="11.5" Canvas.Top="35.5" Width="7" Height="7" Fill="#FFFFFFFF" />
                                <Ellipse Canvas.Left="38.5" Canvas.Top="13.5" Width="7" Height="7" Fill="#FFFFFFFF" />
                            </Canvas>
                        </Border>

                        <TextBlock Text="Welcome to RouteScope" Style="{StaticResource Text.Display}"
                                   FontSize="24" HorizontalAlignment="Center" Margin="0,20,0,0" />
                        <TextBlock Text="Send only the apps you pick through your proxy. Everything else on your PC keeps using your normal connection."
                                   Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                                   MaxWidth="440" Margin="0,10,0,0" HorizontalAlignment="Center" />

                        <StackPanel Margin="0,24,0,0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource B.Accent.Soft}">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Point it at a folder" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Every program inside that folder is routed — no per-app setup."
                                               Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource B.Accent.Soft}">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Works with apps that have no proxy setting" FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Games, launchers and clients that only know how to connect directly."
                                               Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource B.Accent.Soft}">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Chain through another local proxy" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Already running v2rayN, Clash or Hiddify? Reuse its port — no second server needed."
                                               Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Button Content="Get started" Style="{StaticResource Btn.Gradient}" Height="42"
                                Margin="0,28,0,0" Command="{Binding NextOnboardingCommand}" />
                    </StackPanel>

                                        <!-- step 2 -->
                    <StackPanel Visibility="{Binding OnboardingIsMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="How should RouteScope catch traffic?" Style="{StaticResource Text.H1}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="You can switch this at any time."
                                   Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                                   Margin="0,8,0,22" />

                        <Button Style="{StaticResource Btn.Secondary}" Padding="18,16" HorizontalContentAlignment="Left"
                                Command="{Binding SetModeCommand}" CommandParameter="Process"
                                Click="OnboardingMode_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.Accent.Soft}">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Process mode" FontSize="13" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Chip}" Padding="7,1" Margin="8,0,0,0"
                                                Background="{StaticResource B.Accent.Soft}" BorderThickness="0">
                                            <TextBlock Text="recommended" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource B.Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Intercepts only your listed apps — games included. Asks for administrator once."
                                               Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"
                                           Foreground="{StaticResource B.Text.Tertiary}" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource Btn.Secondary}" Padding="18,16" Margin="0,10,0,0"
                                HorizontalContentAlignment="Left"
                                Command="{Binding SetModeCommand}" CommandParameter="AppProxy"
                                Click="OnboardingMode_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.Bg.Active}">
                                    <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{StaticResource B.Accent2}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="App proxy" FontSize="13" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Chip}" Padding="7,1" Margin="8,0,0,0">
                                            <TextBlock Text="no admin" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource B.Text.Tertiary}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Only the apps you start from RouteScope. Nothing else on your PC changes."
                                               Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"
                                           Foreground="{StaticResource B.Text.Tertiary}" />
                            </Grid>
                        </Button>
                    </StackPanel>

<!-- step 3 -->
                    <StackPanel Visibility="{Binding OnboardingIsTarget, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="What should go through the proxy?" Style="{StaticResource Text.H1}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Start with one app or one folder. You can add more later."
                                   Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                                   Margin="0,8,0,22" />

                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource Btn.Secondary}" Padding="14,18" Margin="0,0,6,0"
                                    Command="{Binding AddFolderCommand}" Click="OnboardingAdd_Click">
                                <StackPanel>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="18"
                                               Foreground="{StaticResource B.Accent}" />
                                    <TextBlock Text="A folder" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Secondary}" Padding="14,18" Margin="3,0,3,0"
                                    Command="{Binding AddApplicationCommand}" Click="OnboardingAdd_Click">
                                <StackPanel>
                                    <TextBlock Text="&#xECAA;" Style="{StaticResource Icon}" FontSize="18"
                                               Foreground="{StaticResource B.Accent}" />
                                    <TextBlock Text="An app" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Secondary}" Padding="14,18" Margin="6,0,0,0"
                                    Click="OnboardingPickRunning_Click">
                                <StackPanel>
                                    <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="18"
                                               Foreground="{StaticResource B.Accent}" />
                                    <TextBlock Text="Running app" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <Grid Margin="0,24,0,0">
                        <Button Content="Skip for now" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                                HorizontalAlignment="Left" Command="{Binding FinishOnboardingCommand}" />
                        <Button Content="Done" Style="{StaticResource Btn.Primary}" MinWidth="120"
                                HorizontalAlignment="Right" Command="{Binding FinishOnboardingCommand}"
                                Visibility="{Binding OnboardingIsTarget, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- busy overlay -->
        <Border Grid.RowSpan="2" Background="#B3000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Width="320" Style="{StaticResource Card}" Padding="26" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource B.Accent}"
                                 Background="{StaticResource B.Bg.Active}" BorderThickness="0" />
                    <TextBlock Text="{Binding BusyMessage}" Margin="0,16,0,0" Style="{StaticResource Text.Body}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- engine download overlay -->
        <Border Grid.RowSpan="2" Background="#CC000000"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
            <Border Width="420" Style="{StaticResource Card}" Padding="28" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Setting up the engine" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="RouteScope needs an engine to do transparent, per-app routing. It is downloaded once and can be updated from Settings."
                               Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Margin="0,20,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding DownloadFraction, Mode=OneWay}"
                                 Foreground="{StaticResource B.AccentGradient}"
                                 Background="{StaticResource B.Bg.Active}" BorderThickness="0" />
                    <TextBlock Text="{Binding DownloadText}" Margin="0,10,0,0" Style="{StaticResource Text.Mono}" />
                    <Button Content="Cancel download" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding CancelDownloadCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- toast -->
        <Border Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,26,26" Style="{StaticResource Card.Tight}" Padding="16,12"
                Background="{StaticResource B.Bg.Elevated}" CornerRadius="12" MaxWidth="440"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="#FF000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13"
                           Foreground="{StaticResource B.Success}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding Toast}" MaxWidth="370" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" FontSize="12.5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
