<Application x:Class="RouteScope.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RouteScope.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:BrushKeyConverter x:Key="BrushKey" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:ExeIconConverter x:Key="ExeIcon" />
            <conv:NoIconVisibilityConverter x:Key="NoIconVis" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
                <Setter Property="FontSize" Value="{StaticResource T.Body}" />
                <Setter Property="Foreground" Value="{StaticResource B.Text.Primary}" />
                <Setter Property="Background" Value="{StaticResource B.Bg.Base}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
                <Setter Property="FontSize" Value="{StaticResource T.Body}" />
                <Setter Property="Foreground" Value="{StaticResource B.Text.Primary}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
