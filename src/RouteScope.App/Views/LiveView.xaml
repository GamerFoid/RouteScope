<UserControl x:Class="RouteScope.App.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RouteScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- summary strip -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card.Tight}" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13"
                               Foreground="{StaticResource B.Accent}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding ConnectionCountLabel}" FontSize="12.5" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card.Tight}" Padding="14,10" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="12"
                               Foreground="{StaticResource B.Accent2}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding DownSpeedText}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="12" Margin="16,0,7,0"
                               Foreground="{StaticResource B.Accent}" />
                    <TextBlock Text="{Binding UpSpeedText}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Text.Secondary}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card.Tight}" Padding="14,10" Margin="10,0,0,0"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TOTAL" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="11" Margin="12,0,6,0"
                               Foreground="{StaticResource B.Accent2}" />
                    <TextBlock Text="{Binding TotalDownText}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="11" Margin="14,0,6,0"
                               Foreground="{StaticResource B.Accent}" />
                    <TextBlock Text="{Binding TotalUpText}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Text.Secondary}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="3" Content="Close all connections" Style="{StaticResource Btn.Ghost}"
                    FontSize="11.5" Command="{Binding CloseConnectionsCommand}" />
        </Grid>

        <!-- table -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Border Grid.Row="0" Background="{StaticResource B.Bg.Elevated}" CornerRadius="15,15,0,0"
                        Padding="16,11">
                    <Grid TextElement.FontSize="10.5" TextElement.Foreground="{StaticResource B.Text.Tertiary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROCESS" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="DESTINATION" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="NET" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="RULE" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="UP" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="DOWN" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,9" BorderBrush="{StaticResource B.Border.Subtle}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DisplayProcess}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Destination}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource B.Text.Secondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Network}" FontSize="10.5"
                                                   Foreground="{StaticResource B.Text.Tertiary}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Chain}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource B.Accent}" />
                                        <TextBlock Grid.Column="4" FontSize="11" TextAlignment="Right"
                                                   Foreground="{StaticResource B.Text.Tertiary}"
                                                   Text="{Binding Upload, Converter={StaticResource Bytes}}" />
                                        <TextBlock Grid.Column="5" FontSize="11" TextAlignment="Right"
                                                   Foreground="{StaticResource B.Text.Tertiary}"
                                                   Text="{Binding Download, Converter={StaticResource Bytes}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- empty -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ConnectionCount, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="30"
                               Foreground="{StaticResource B.Text.Tertiary}" HorizontalAlignment="Center" />
                    <TextBlock Text="No connections yet" Style="{StaticResource Text.H3}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Start routing, then open one of your apps. Everything it connects to shows up here."
                               Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                               MaxWidth="380" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
