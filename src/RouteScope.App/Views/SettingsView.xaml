<UserControl x:Class="RouteScope.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RouteScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text.Tertiary}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
            <!-- ================= capture mode ================= -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="How traffic is captured" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="Switch any time. The first two modes only touch the apps you add; the other two route everything."
                               Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" />
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- app proxy (recommended) -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource SelectCard}"
                        Command="{Binding SetModeCommand}" CommandParameter="AppProxy"
                        Tag="{Binding IsAppProxy}">
                    <StackPanel>
                        <Grid>
                            <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                    Background="{StaticResource B.Bg.Active}">
                                <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="15"
                                           Foreground="{StaticResource B.Accent2}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="no admin" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource B.Text.Tertiary}" />
                                <Border Style="{StaticResource RadioDot}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="App proxy" Style="{StaticResource Text.H3}" Margin="0,12,0,0" />
                        <TextBlock Text="Only the apps you launch from here. No admin, and nothing else on your PC is touched."
                                   Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>

                <!-- process mode (selective, driver-based) -->
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SelectCard}"
                        Command="{Binding SetModeCommand}" CommandParameter="Process"
                        Tag="{Binding IsProcessMode}">
                    <StackPanel>
                        <Grid>
                            <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                    Background="{StaticResource B.Accent.Soft}">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="15"
                                           Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Recommended" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource B.Accent}" />
                                <Border Style="{StaticResource RadioDot}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Process mode" Style="{StaticResource Text.H3}" Margin="0,12,0,0" />
                        <TextBlock Text="Intercepts only your listed apps at the socket layer — works for games that have no proxy support at all."
                                   Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>

                <!-- whole computer -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource SelectCard}"
                        Command="{Binding SetModeCommand}" CommandParameter="Transparent"
                        Tag="{Binding IsTransparent}">
                    <StackPanel>
                        <Grid>
                            <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                    Background="{StaticResource B.Bg.Active}">
                                <TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}" FontSize="15"
                                           Foreground="{StaticResource B.Accent2}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="admin" FontSize="9.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource B.Text.Tertiary}" />
                                <Border Style="{StaticResource RadioDot}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Whole computer (TUN)" Style="{StaticResource Text.H3}" Margin="0,12,0,0" />
                        <TextBlock Text="Captures every app on this PC. Only for when you actually want the whole machine routed."
                                   Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>

                <!-- system proxy -->
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SelectCard}"
                        Command="{Binding SetModeCommand}" CommandParameter="SystemProxy"
                        Tag="{Binding IsSystemProxy}">
                    <StackPanel>
                        <Grid>
                            <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                    Background="{StaticResource B.Bg.Active}">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15"
                                           Foreground="{StaticResource B.Text.Secondary}" />
                            </Border>
                            <Border Style="{StaticResource RadioDot}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="System proxy" Style="{StaticResource Text.H3}" Margin="0,12,0,0" />
                        <TextBlock Text="Sets the Windows proxy. Covers the apps that follow it — usually just browsers."
                                   Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= network ================= -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Network" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="The local port your apps can point at." Style="{StaticResource Text.Secondary}"
                                   Margin="0,4,0,18" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Proxy port" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="HTTP + SOCKS5 on 127.0.0.1" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{StaticResource Input}" Height="34"
                                     Text="{Binding Settings.MixedPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Dashboard port" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Clash API used for live stats" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{StaticResource Input}" Height="34"
                                     Text="{Binding Settings.ClashApiPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,2,0,16" />

                        <StackPanel>
                            <TextBlock Text="Engine" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource Text.Mono}"
                                       Margin="0,4,0,10" />
                            <Button Content="Show config" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                                    HorizontalAlignment="Left" Command="{Binding OpenConfigCommand}" />
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Which core routes traffic" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="{Binding EngineChoiceHint}" Style="{StaticResource RowHint}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Combo}" Height="34"
                                      SelectedValue="{Binding PreferredEngine, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Automatic" Tag="auto" />
                                <ComboBoxItem Content="sing-box" Tag="singbox" />
                                <ComboBoxItem Content="Xray-core" Tag="xray" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Psiphon" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding PsiphonStatusText}" Style="{StaticResource RowHint}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Psiphon exit country" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Which country the tunnel should leave from" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Combo}" Height="34"
                                      SelectedValue="{Binding PsiphonRegion, Mode=TwoWay}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Automatic" Tag="" />
                                <ComboBoxItem Content="United States" Tag="US" />
                                <ComboBoxItem Content="United Kingdom" Tag="GB" />
                                <ComboBoxItem Content="Germany" Tag="DE" />
                                <ComboBoxItem Content="Netherlands" Tag="NL" />
                                <ComboBoxItem Content="France" Tag="FR" />
                                <ComboBoxItem Content="Canada" Tag="CA" />
                                <ComboBoxItem Content="Japan" Tag="JP" />
                                <ComboBoxItem Content="Singapore" Tag="SG" />
                                <ComboBoxItem Content="India" Tag="IN" />
                                <ComboBoxItem Content="Turkey" Tag="TR" />
                                <ComboBoxItem Content="United Arab Emirates" Tag="AE" />
                                <ComboBoxItem Content="Australia" Tag="AU" />
                                <ComboBoxItem Content="Brazil" Tag="BR" />
                                <ComboBoxItem Content="Sweden" Tag="SE" />
                                <ComboBoxItem Content="Switzerland" Tag="CH" />
                                <ComboBoxItem Content="Poland" Tag="PL" />
                                <ComboBoxItem Content="Romania" Tag="RO" />
                                <ComboBoxItem Content="Finland" Tag="FI" />
                                <ComboBoxItem Content="Norway" Tag="NO" />
                                <ComboBoxItem Content="Italy" Tag="IT" />
                                <ComboBoxItem Content="Spain" Tag="ES" />
                                <ComboBoxItem Content="South Korea" Tag="KR" />
                                <ComboBoxItem Content="Hong Kong" Tag="HK" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= dns ================= -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DNS" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="How hostnames are resolved for proxied apps."
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,18" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Resolution" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Remote DNS avoids leaks through your ISP" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Combo}" Height="34"
                                      SelectedValue="{Binding Settings.Dns.Mode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Through proxy" Tag="proxy" />
                                <ComboBoxItem Content="Direct" Tag="direct" />
                                <ComboBoxItem Content="System" Tag="system" />
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Prefer IPv4" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Falls back to IPv6 when needed" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Settings.Dns.PreferIpv4, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Bypass local network" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="LAN devices and printers stay direct" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Settings.Advanced.BypassLan, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= behaviour + updates ================= -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Behaviour" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="How RouteScope starts and stays out of the way."
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,18" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start routing on launch" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Resume the last destination automatically" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.StartEngineOnLaunch, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Keeps your routing ready after a reboot" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Notifications" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Confirm when routing starts or stops" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.NotifyOnStateChange, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="When I close the window" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Keep routing in the tray, or shut down" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Combo}" Height="34"
                                      SelectedValue="{Binding Settings.CloseAction, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Ask me" Tag="ask" />
                                <ComboBoxItem Content="Minimise to tray" Tag="tray" />
                                <ComboBoxItem Content="Exit completely" Tag="exit" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="RouteScope keeps the cores current for you."
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,18" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Update cores automatically" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="sing-box and Xray-core" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.AutoUpdateEngines, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Check on launch" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="A quiet background version check" Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.CheckUpdatesOnLaunch, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Download mirror" Style="{StaticResource RowLabel}" Margin="0,4,0,6" />
                        <TextBlock Text="Used when GitHub is blocked. Leave empty to always download directly."
                                   Style="{StaticResource RowHint}" Margin="0,0,0,8" />
                        <TextBox Style="{StaticResource Input}" Height="34"
                                 Text="{Binding Settings.Mirror, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= cores & updates ================= -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cores &amp; updates" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding DownloadViaProxy, Mode=TwoWay}"
                                      ToolTip="Fetch downloads through your current route" />
                            <TextBlock Text="Download through the proxy" FontSize="10.5" Margin="9,0,16,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource B.Text.Secondary}" />
                            <Button Content="Check for updates" FontSize="11.5"
                                    Style="{StaticResource Btn.Ghost}" Command="{Binding CheckEngineUpdatesCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="RouteScope keeps its engines side by side, so an update never breaks a working install."
                               Style="{StaticResource Text.Secondary}" Margin="0,5,0,16" />

                    <ItemsControl ItemsSource="{Binding Engines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource B.Bg.Sunken}" CornerRadius="12" Padding="14,11"
                                        Margin="0,0,0,8" BorderBrush="{StaticResource B.Border.Subtle}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                                 Margin="0,0,12,0"
                                                 Fill="{Binding StatusKey, Converter={StaticResource BrushKey}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                <Border Background="{StaticResource B.Bg.Active}" CornerRadius="6"
                                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RoleLabel}" FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource B.Text.Tertiary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                       Foreground="{StaticResource B.Text.Tertiary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <ProgressBar Height="3" Margin="0,7,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         Foreground="{StaticResource B.AccentGradient}"
                                                         Background="{StaticResource B.Bg.Active}"
                                                         BorderThickness="0"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,14,0"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding VersionText}" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource F.Mono}"
                                                       Foreground="{StaticResource B.Text.Secondary}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180"
                                                       Foreground="{StaticResource B.Text.Tertiary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionLabel}" FontSize="11.5"
                                                    Style="{StaticResource Btn.Secondary}" MinWidth="86" Padding="12,6"
                                                    IsEnabled="{Binding CanAct}"
                                                    Command="{Binding DataContext.InstallEngineCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Locate…" FontSize="11" Style="{StaticResource Btn.Ghost}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.LocateEngineCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Use a copy you already have instead of downloading one" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- OpenVPN is not a downloadable core, so it gets its own row. -->
                    <Border Background="{StaticResource B.Bg.Sunken}" CornerRadius="12" Padding="14,11"
                            BorderBrush="{StaticResource B.Border.Subtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                    Background="{StaticResource B.Bg.Active}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="OpenVPN" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Chip}" Padding="8,2" Margin="9,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="tunnel" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource B.Text.Tertiary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding OpenVpnStatusText}" FontSize="10.5" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource B.Text.Tertiary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Download" FontSize="11" Style="{StaticResource Btn.Secondary}"
                                        Padding="12,6" Command="{Binding OpenVpnDownloadCommand}" />
                                <Button Content="Locate…" FontSize="11" Style="{StaticResource Btn.Ghost}"
                                        Margin="6,0,0,0" Command="{Binding LocateOpenVpnCommand}"
                                        ToolTip="Point RouteScope at openvpn.exe" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= advanced ================= -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Padding="0"
                            Click="ToggleAdvanced_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="12"
                                       Foreground="{StaticResource B.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Advanced" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9"
                                       Margin="10,0,0,0" Foreground="{StaticResource B.Text.Tertiary}" />
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="These knobs are optional. Defaults work for almost everyone."
                                   Style="{StaticResource Text.Secondary}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Log level" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource Combo}" Height="34"
                                          SelectedValue="{Binding Settings.Advanced.LogLevel, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Info" Tag="info" />
                                    <ComboBoxItem Content="Debug" Tag="debug" />
                                    <ComboBoxItem Content="Warn" Tag="warn" />
                                    <ComboBoxItem Content="Error" Tag="error" />
                                </ComboBox>

                                <TextBlock Text="TUN stack" Style="{StaticResource RowLabel}" Margin="0,14,0,6" />
                                <ComboBox Style="{StaticResource Combo}" Height="34"
                                          SelectedValue="{Binding Settings.Advanced.TunStack, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Mixed (recommended)" Tag="mixed" />
                                    <ComboBoxItem Content="gVisor" Tag="gvisor" />
                                    <ComboBoxItem Content="System" Tag="system" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MTU" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource Input}" Height="34"
                                         Text="{Binding Settings.Advanced.Mtu, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Strict route" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="Blocks leaks around the tunnel" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.Advanced.StrictRoute, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Process mode: intercept UDP" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="Most games need this. Turn it off if a game misbehaves." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.Advanced.ProcessModeUdp, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Verbose engine log" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="Show every per-connection line from the engine" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.Advanced.VerboseEngineLog, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,18,0,16" />

                        <TextBlock Text="Extra sing-box route rules (JSON array)" Style="{StaticResource RowLabel}" />
                        <TextBox Style="{StaticResource Input}" Height="76" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="{StaticResource F.Mono}" FontSize="11"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding Settings.Advanced.ExtraRouteRulesJson, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Config override (JSON object, merged last)" Style="{StaticResource RowLabel}"
                                   Margin="0,14,0,0" />
                        <TextBox Style="{StaticResource Input}" Height="76" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="{StaticResource F.Mono}" FontSize="11"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding Settings.Advanced.ConfigOverrideJson, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= about ================= -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource B.AccentGradient}">
                                <Canvas Width="26" Height="26">
                                    <Path Data="M 7,18 C 12,18 12,8 19,8" Stroke="#FFFFFFFF" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="5.4" Canvas.Top="16.4" Width="3.2" Height="3.2" Fill="#FFFFFFFF" />
                                    <Ellipse Canvas.Left="17.4" Canvas.Top="6.4" Width="3.2" Height="3.2" Fill="#FFFFFFFF" />
                                </Canvas>
                            </Border>
                            <TextBlock Text="RouteScope 1.0.0" Style="{StaticResource Text.H3}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Route only what you choose — never the whole machine. Apps, folders and games, with engines that keep themselves current."
                                   Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" MaxWidth="520"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save settings" Style="{StaticResource Btn.Primary}"
                            VerticalAlignment="Center" Command="{Binding SaveSettingsCommand}" />
                </Grid>
            </Border>

            <StackPanel Height="20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
