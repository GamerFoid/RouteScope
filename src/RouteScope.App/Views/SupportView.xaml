<UserControl x:Class="RouteScope.App.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RouteScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <StackPanel>

        <!-- ======================== support ======================== -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource B.Accent.Soft}">
                        <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="15"
                                   Foreground="{StaticResource B.Accent}" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Support RouteScope" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="Free, open source, and built in the open."
                                   Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                           Foreground="{StaticResource B.Text.Secondary}">
                    RouteScope is a spare-time project and always will be free to use. There is no
                    paid tier, no account, and nothing is collected about you. If it saves you time
                    and you feel like giving something back, a donation is genuinely appreciated —
                    it goes towards the time it takes to keep the engines updated and the bug
                    reports answered.
                </TextBlock>

                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                           Foreground="{StaticResource B.Text.Tertiary}">
                    Donating is entirely optional. Every feature works exactly the same either way.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ======================== crypto ======================== -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Crypto" Style="{StaticResource Text.H3}" />
                <TextBlock Text="USDT or any other token. Always double-check the network before sending."
                           Style="{StaticResource Text.Secondary}" Margin="0,5,0,16" TextWrapping="Wrap" />

                <!-- BEP20 -->
                <Border Background="{StaticResource B.Bg.Sunken}" CornerRadius="12" Padding="16,14"
                        BorderBrush="{StaticResource B.Border.Subtle}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Binance Smart Chain" FontSize="12.5" FontWeight="SemiBold" />
                                <Border Background="{StaticResource B.Accent.Soft}" CornerRadius="6"
                                        Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BEP20" FontSize="8.5" FontWeight="Bold"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="0x5c2031e823f6c1774a1F842209bbE3b679cf3feC"
                                       FontFamily="{StaticResource F.Mono}" FontSize="11.5" Margin="0,7,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource B.Text.Secondary}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Copy" Style="{StaticResource Btn.Secondary}"
                                FontSize="11.5" Padding="14,7" VerticalAlignment="Center"
                                Command="{Binding CopyTextCommand}"
                                CommandParameter="0x5c2031e823f6c1774a1F842209bbE3b679cf3feC" />
                    </Grid>
                </Border>

                <!-- TRC20 -->
                <Border Background="{StaticResource B.Bg.Sunken}" CornerRadius="12" Padding="16,14"
                        Margin="0,10,0,0"
                        BorderBrush="{StaticResource B.Border.Subtle}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tron" FontSize="12.5" FontWeight="SemiBold" />
                                <Border Background="{StaticResource B.Accent.Soft}" CornerRadius="6"
                                        Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TRC20" FontSize="8.5" FontWeight="Bold"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="TVtGyKkfm6RDEtW1yFau3EkNk9XXVdTJob"
                                       FontFamily="{StaticResource F.Mono}" FontSize="11.5" Margin="0,7,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource B.Text.Secondary}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Copy" Style="{StaticResource Btn.Secondary}"
                                FontSize="11.5" Padding="14,7" VerticalAlignment="Center"
                                Command="{Binding CopyTextCommand}"
                                CommandParameter="TVtGyKkfm6RDEtW1yFau3EkNk9XXVdTJob" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ======================== other ways ======================== -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Other ways to help" Style="{StaticResource Text.H3}" />
                <TextBlock Text="These cost nothing and are worth just as much." TextWrapping="Wrap"
                           Style="{StaticResource Text.Secondary}" Margin="0,5,0,14" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE735;" Style="{StaticResource Icon}" FontSize="12"
                               Foreground="{StaticResource B.Accent}" VerticalAlignment="Top" Margin="0,2,11,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Star the repository" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="It is how other people find the project."
                                   FontSize="11" Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE8A8;" Style="{StaticResource Icon}" FontSize="12"
                               Foreground="{StaticResource B.Accent}" VerticalAlignment="Top" Margin="0,2,11,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Report what breaks" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Include the Activity log — it usually contains the answer."
                                   FontSize="11" Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="12"
                               Foreground="{StaticResource B.Accent}" VerticalAlignment="Top" Margin="0,2,11,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tell someone" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="One post in the right forum does more than a donation."
                                   FontSize="11" Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Project page" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                            Command="{Binding OpenProjectPageCommand}" />
                    <Button Content="Report an issue" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                            Margin="6,0,0,0" Command="{Binding OpenIssuesCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================== about ======================== -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="RouteScope" Style="{StaticResource Text.H3}" />
                    <TextBlock Text="GPL-3.0 · free software, no telemetry, no account."
                               Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Licence" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                            Command="{Binding OpenLicenceCommand}" />
                    <Button Content="Open data folder" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                            Margin="6,0,0,0" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
