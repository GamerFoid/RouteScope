<Window x:Class="RouteScope.App.Dialogs.OpenVpnCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenVPN login"
        Width="420" Height="310" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource B.Border.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="22,18,22,8" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource B.Accent.Soft}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13"
                                   Foreground="{StaticResource B.Accent}" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OpenVPN login" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="Subtitle" Text="This config needs a username and password"
                                   FontSize="10.5" Margin="0,2,0,0" Foreground="{StaticResource B.Text.Tertiary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,12,22,0">
                <TextBlock Text="Username" FontSize="10" Margin="1,0,0,5"
                           Foreground="{StaticResource B.Text.Tertiary}" />
                <TextBox x:Name="UserBox" Style="{StaticResource Input}" />

                <TextBlock Text="Password" FontSize="10" Margin="1,12,0,5"
                           Foreground="{StaticResource B.Text.Tertiary}" />
                <PasswordBox x:Name="PassBox" Height="34" FontSize="12.5" Padding="10,0"
                             Background="{StaticResource B.Bg.Sunken}"
                             Foreground="{StaticResource B.Text.Primary}"
                             BorderBrush="{StaticResource B.Border.Subtle}" BorderThickness="1" />

                <TextBlock Text="Stored in the local profile, just like the rest of your settings."
                           FontSize="10" Margin="1,12,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource B.Text.Tertiary}" />
                <TextBlock x:Name="Hint" FontSize="10.5" Margin="1,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource B.Warning}" />
            </StackPanel>

            <Border Grid.Row="2" Padding="22,12" BorderBrush="{StaticResource B.Border.Subtle}"
                    BorderThickness="0,1,0,0" Background="{StaticResource B.Bg.Surface}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Btn.Ghost}" FontSize="11.5"
                            Click="Cancel_Click" />
                    <Button Content="Save" Style="{StaticResource Btn.Primary}" FontSize="12"
                            MinWidth="92" Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
