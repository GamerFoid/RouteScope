<Window x:Class="RouteScope.App.Dialogs.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close RouteScope"
        Width="470" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource B.Border.Default}" BorderThickness="1" Padding="26,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.Bg.Elevated}">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="15"
                               Foreground="{StaticResource B.Accent}" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Close RouteScope?" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Routing is still running." FontSize="11"
                               Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="TrayButton" Style="{StaticResource Btn.Secondary}" Margin="0,22,0,0"
                    Padding="16,14" HorizontalContentAlignment="Stretch" Click="Tray_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource B.Accent.Soft}">
                        <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="13"
                                   Foreground="{StaticResource B.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="Minimise to tray" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="Keep routing in the background." FontSize="10.5"
                                   Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="recommended" FontSize="9.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource B.Accent}" />
                </Grid>
            </Button>

            <Button x:Name="ExitButton" Style="{StaticResource Btn.Secondary}" Margin="0,10,0,0"
                    Padding="16,14" HorizontalContentAlignment="Stretch" Click="Exit_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource B.Bg.Active}">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="12"
                                   Foreground="{StaticResource B.Text.Secondary}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Exit completely" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="Stop routing and close RouteScope." FontSize="10.5"
                                   Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="RememberCheck" Style="{StaticResource Switch}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Remember my choice" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource B.Text.Secondary}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource Btn.Ghost}"
                        FontSize="11.5" Click="Cancel_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
