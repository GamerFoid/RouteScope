<Window x:Class="RouteScope.App.Dialogs.ConfigEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Config"
        Width="700" Height="680" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource B.Border.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,20,24,14" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B.Accent.Soft}">
                        <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="14"
                                   Foreground="{StaticResource B.Accent}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Imported config" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="A complete Xray config from a subscription. RouteScope runs it as-is."
                                   FontSize="10.5" Margin="0,2,0,0" Foreground="{StaticResource B.Text.Tertiary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,0,24,10">
                <TextBlock Text="Name" FontSize="10" Margin="1,0,0,5"
                           Foreground="{StaticResource B.Text.Tertiary}" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="24,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Config (JSON)" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource B.Text.Tertiary}" />
                    <TextBlock x:Name="HintText" HorizontalAlignment="Right" FontSize="10"
                               Foreground="{StaticResource B.Text.Tertiary}" />
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource B.Bg.Sunken}" CornerRadius="10"
                        BorderBrush="{StaticResource B.Border.Subtle}" BorderThickness="1" Padding="2">
                    <TextBox x:Name="JsonBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource B.Text.Secondary}" FontFamily="Consolas" FontSize="11"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="10" />
                </Border>
            </Grid>

            <Border Grid.Row="3" Padding="24,14" BorderBrush="{StaticResource B.Border.Subtle}"
                    BorderThickness="0,1,0,0" Background="{StaticResource B.Bg.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Btn.Ghost}" FontSize="11" Click="Reset_Click"
                            Content="Reset to original" VerticalAlignment="Center" />

                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource Btn.Ghost}"
                            FontSize="11.5" VerticalAlignment="Center" Click="Cancel_Click" />
                    <Button Grid.Column="3" Content="Save" Style="{StaticResource Btn.Primary}"
                            FontSize="12" MinWidth="96" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="Save_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
