<Window x:Class="RouteScope.App.Dialogs.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a running app"
        Width="560" Height="600" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource B.Border.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="{StaticResource B.Bg.Sunken}" Height="52"
                  MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="14"
                               Foreground="{StaticResource B.Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="Pick a running app" FontSize="13.5" FontWeight="SemiBold" />
                </StackPanel>
                <Button Style="{StaticResource Btn.Ghost}" Width="46" Height="52" HorizontalAlignment="Right"
                        Padding="0" Click="Close_Click">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
            </Grid>

            <!-- search -->
            <Border Grid.Row="1" Margin="20,16,20,10">
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Tag="Search apps…"
                             TextChanged="Search_TextChanged" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12"
                               HorizontalAlignment="Right" Margin="0,0,14,0"
                               Foreground="{StaticResource B.Text.Tertiary}" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- list -->
            <ListBox x:Name="ProcessList" Grid.Row="2" Margin="12,0,12,0"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ProcessList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="B" Background="Transparent" CornerRadius="9" Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource B.Bg.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource B.Bg.Active}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="26" Height="26"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Path}" FontSize="10.5"
                                           Foreground="{StaticResource B.Text.Tertiary}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- footer -->
            <Grid Grid.Row="3" Margin="20,12,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Double-click to add. Child processes are included automatically."
                           Style="{StaticResource Text.Caption}" VerticalAlignment="Center" FontWeight="Normal" />
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource Btn.Ghost}" Click="Close_Click" />
                <Button Grid.Column="2" Content="Add selected" Style="{StaticResource Btn.Primary}"
                        Margin="8,0,0,0" Click="Add_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
