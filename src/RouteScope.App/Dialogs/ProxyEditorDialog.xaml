<Window x:Class="RouteScope.App.Dialogs.ProxyEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local proxy"
        Width="440" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource B.Border.Default}" BorderThickness="1" Padding="26,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource B.Accent.Soft}">
                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="14"
                               Foreground="{StaticResource B.Accent}" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Local proxy" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Any SOCKS5 or HTTP proxy already running on this machine."
                               FontSize="10.5" Foreground="{StaticResource B.Text.Tertiary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Name" Style="{StaticResource Text.Caption}" Margin="0,20,0,6" />
            <TextBox x:Name="NameBox" Style="{StaticResource Input}" Tag="e.g. v2rayN, Clash, Hiddify" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Host" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                    <TextBox x:Name="HostBox" Style="{StaticResource Input}" Tag="127.0.0.1" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Port" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                    <TextBox x:Name="PortBox" Style="{StaticResource Input}" Tag="10808" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Type" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
            <ComboBox x:Name="TypeBox" Style="{StaticResource Combo}" Height="34" SelectedValuePath="Tag">
                <ComboBoxItem Content="Detect automatically" Tag="Auto" />
                <ComboBoxItem Content="SOCKS5" Tag="SOCKS5" />
                <ComboBoxItem Content="HTTP" Tag="HTTP" />
            </ComboBox>

            <TextBlock x:Name="ErrorText" FontSize="10.5" Margin="0,10,0,0"
                       Foreground="{StaticResource B.Danger}" Visibility="Collapsed" TextWrapping="Wrap" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource Btn.Ghost}"
                        FontSize="11.5" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="Save" Style="{StaticResource Btn.Primary}"
                        FontSize="12" MinWidth="90" Margin="8,0,0,0" Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
