<Window x:Class="RouteScope.App.Dialogs.NodeEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server"
        Width="660" Height="740" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource B.Bg.Base}"
        Foreground="{StaticResource B.Text.Primary}"
        FontFamily="{StaticResource F.Ui}" FontSize="{StaticResource T.Body}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="1,0,0,5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text.Tertiary}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Text.Secondary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource B.Border.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0" Padding="28,24,28,16" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource B.Accent.Soft}">
                            <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{StaticResource B.Accent}" />
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Edit server" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="SubtitleText" FontSize="10.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource B.Text.Tertiary}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Icon}"
                            Width="30" Height="30" Click="Cancel_Click" ToolTip="Close">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <!-- form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,20,0">
                <StackPanel Margin="0,0,8,0">

                    <!-- basics -->
                    <Border Style="{StaticResource Card.Tight}" Padding="18,16,18,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Basics" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Tag="My server" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ServerBox" Style="{StaticResource FieldBox}" Tag="example.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PortBox" Style="{StaticResource FieldBox}" Tag="443" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ProtocolBox" Style="{StaticResource Combo}" Height="36"
                                              Margin="0,0,0,10" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- credentials -->
                    <Border Style="{StaticResource Card.Tight}" Padding="18,16,18,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Credentials" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="UUID" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="UuidBox" Style="{StaticResource FieldBox}" Tag="vless / vmess / tuic" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PasswordBox" Style="{StaticResource FieldBox}"
                                             Tag="trojan / ss / hysteria2" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="UsernameBox" Style="{StaticResource FieldBox}" Tag="socks / http" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cipher" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="MethodBox" Style="{StaticResource FieldBox}" Tag="aes-256-gcm" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Flow" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FlowBox" Style="{StaticResource FieldBox}" Tag="xtls-rprx-vision" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- tls -->
                    <Border Style="{StaticResource Card.Tight}" Padding="18,16,18,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TLS &amp; security" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Security" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="SecurityBox" Style="{StaticResource Combo}" Height="36"
                                              Margin="0,0,0,10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SNI / server name" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SniBox" Style="{StaticResource FieldBox}" Tag="server name" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Fingerprint" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FpBox" Style="{StaticResource FieldBox}" Tag="chrome" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ALPN (comma separated)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AlpnBox" Style="{StaticResource FieldBox}" Tag="h2, http/1.1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Skip certificate check" Style="{StaticResource FieldLabel}" />
                                    <CheckBox x:Name="InsecureCheck" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Reality public key" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PbkBox" Style="{StaticResource FieldBox}" Tag="pbk" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Short id" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SidBox" Style="{StaticResource FieldBox}" Tag="sid" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="SpiderX" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SpxBox" Style="{StaticResource FieldBox}" Tag="/" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- transport -->
                    <Border Style="{StaticResource Card.Tight}" Padding="18,16,18,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Transport" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="TransportBox" Style="{StaticResource Combo}" Height="36"
                                              Margin="0,0,0,10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Host / authority" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="HostBox" Style="{StaticResource FieldBox}" Tag="cdn.example.com" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Path" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" Tag="/ws" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="gRPC service name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ServiceBox" Style="{StaticResource FieldBox}" Tag="serviceName" />
                        </StackPanel>
                    </Border>

                    <!-- extras -->
                    <Border x:Name="ExtraPanel" Style="{StaticResource Card.Tight}" Padding="18,16"
                            Margin="0,0,0,4" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Kept as-is" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="These parameters came with the link and are written back unchanged:"
                                       FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Foreground="{StaticResource B.Text.Tertiary}" />
                            <TextBlock x:Name="ExtraText" FontSize="10" TextWrapping="Wrap" FontFamily="Consolas"
                                       Foreground="{StaticResource B.Text.Secondary}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ErrorText" FontSize="10.5" Margin="2,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource B.Danger}" Visibility="Collapsed" />

                    <StackPanel Height="16" />
                </StackPanel>
            </ScrollViewer>

            <!-- footer -->
            <Border Grid.Row="2" Padding="28,16" BorderBrush="{StaticResource B.Border.Subtle}"
                    BorderThickness="0,1,0,0" Background="{StaticResource B.Bg.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Btn.Secondary}" FontSize="11.5"
                            VerticalAlignment="Center" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                            <TextBlock Text="Copy link" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource Btn.Ghost}"
                            FontSize="11.5" VerticalAlignment="Center" Click="Cancel_Click" />
                    <Button Grid.Column="3" Content="Save" Style="{StaticResource Btn.Primary}"
                            FontSize="12" MinWidth="100" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="Save_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
